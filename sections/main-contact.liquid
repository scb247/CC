<section class="section">
  <div class="container page-narrow">
    <div class="section-head">
      <h1>{{ page.title | default: 'Contact' | escape }}</h1>
      {%- if page.content != blank -%}<div class="rte">{{ page.content }}</div>{%- endif -%}
    </div>
    {%- form 'contact' -%}
      {%- if form.posted_successfully? -%}
        <p class="notice success" role="status">Thanks, we'll get back to you soon.</p>
      {%- endif -%}
      {%- if form.errors -%}
        <div class="notice error" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div class="field">
        <label for="ContactName">Name</label>
        <input id="ContactName" type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}">
      </div>
      <div class="field">
        <label for="ContactEmail">Email</label>
        <input id="ContactEmail" type="email" name="contact[email]" autocomplete="email" required value="{{ form.email }}">
      </div>
      <div class="field">
        <label for="ContactOrder">Order number (optional)</label>
        <input id="ContactOrder" type="text" name="contact[order]" value="{{ form.order }}">
      </div>
      <div class="field">
        <label for="ContactBody">Message</label>
        <textarea id="ContactBody" name="contact[body]">{{ form.body }}</textarea>
      </div>
      <button class="btn btn-glow" type="submit">Send</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{ "name": "Contact form", "settings": [] }
{% endschema %}
