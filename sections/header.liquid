{%- if section.settings.announcement != blank -%}
  <div class="announcement">
    {%- if section.settings.announcement_link != blank -%}
      <a href="{{ section.settings.announcement_link }}">{{ section.settings.announcement | escape }}</a>
    {%- else -%}
      {{ section.settings.announcement | escape }}
    {%- endif -%}
  </div>
{%- endif -%}
<header class="site-header" data-header>
  <div class="container">
    <a class="brand" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} home">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: height: 80 | image_tag: alt: shop.name, height: 34 }}
      {%- else -%}
        <img src="{{ 'crop-circle-logo.png' | asset_url }}" alt="{{ shop.name | escape }}" width="65" height="34">
      {%- endif -%}
    </a>

    <nav class="main-nav" aria-label="Main">
      {%- for link in section.settings.menu.links -%}
        <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
      {%- endfor -%}
    </nav>

    <div class="header-actions">
      <a class="cart-link" href="{{ routes.cart_url }}" aria-label="Cart, {{ cart.item_count }} items">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 7h12l-1 13H7z"/><path d="M9 7a3 3 0 0 1 6 0"/></svg>
        {%- if cart.item_count > 0 -%}<span class="cart-count" data-cart-count>{{ cart.item_count }}</span>{%- endif -%}
      </a>
      <button class="menu-btn" type="button" data-menu-btn aria-expanded="false" aria-controls="MobileNav" aria-label="Open menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>
  <nav class="mobile-nav" id="MobileNav" aria-label="Mobile">
    {%- for link in section.settings.menu.links -%}
      <a href="{{ link.url }}">{{ link.title | escape }}</a>
    {%- endfor -%}
    <a href="{{ routes.cart_url }}">Cart ({{ cart.item_count }})</a>
  </nav>
</header>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo", "info": "Leave empty to use the built-in Crop Circle logo." },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "text", "id": "announcement", "label": "Announcement bar text", "default": "Every piece stitched to order. Free UK delivery over £75." },
    { "type": "url", "id": "announcement_link", "label": "Announcement link" }
  ]
}
{% endschema %}
