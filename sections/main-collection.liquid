{%- paginate collection.products by section.settings.per_page -%}
<section class="section">
  <div class="container">
    <div class="section-head">
      <h1>{{ collection.title | escape }}</h1>
      {%- if collection.description != blank -%}<div class="rte">{{ collection.description }}</div>{%- endif -%}
    </div>
    {%- if collection.products.size > 0 -%}
      <ul class="product-grid" role="list">
        {%- for product in collection.products -%}
          <li>{% render 'product-card', product: product %}</li>
        {%- endfor -%}
      </ul>
      {%- if paginate.pages > 1 -%}
        <nav class="pagination" aria-label="Pagination">
          {%- if paginate.previous -%}<a class="btn btn-ghost" href="{{ paginate.previous.url }}">Previous</a>{%- endif -%}
          {%- if paginate.next -%}<a class="btn btn-ghost" href="{{ paginate.next.url }}">Next</a>{%- endif -%}
        </nav>
      {%- endif -%}
    {%- else -%}
      <p class="empty-state">Nothing here yet. Check back soon.</p>
    {%- endif -%}
  </div>
</section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Collection",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 4, "max": 24, "step": 1, "default": 12 }
  ]
}
{% endschema %}
