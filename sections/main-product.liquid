{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  capture garment
    render 'garment-key', product: product
  endcapture
  assign garment = garment | strip
  assign form_id = 'ProductForm-' | append: section.id
  assign range = section.settings.range_collection
  if range == blank
    assign range = collections['all']
  endif

  assign thread_index = -1
  for option in product.options_with_values
    assign option_name = option.name | downcase
    if option_name contains 'thread' or option_name contains 'colour' or option_name contains 'color'
      assign thread_index = forloop.index0
      break
    endif
  endfor
  assign current_thread = 'Green'
  if thread_index >= 0
    assign current_thread = current_variant.options[thread_index]
  endif
-%}

<section class="product-section" data-product-designer data-section-id="{{ section.id }}" data-product-handle="{{ product.handle }}">
  <div class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a> /
      <a href="{{ routes.all_products_collection_url }}">Shop</a> /
      <span aria-current="page">{{ product.title | escape }}</span>
    </nav>

    <div class="builder">
      {%- comment -%} ---------- Live preview ---------- {%- endcomment -%}
      <div class="stage-wrap">
        <div class="stage" style="--thread-hex: {% render 'thread-colour', name: current_thread, part: 'hex' %};" data-stage>
          <div class="light-toggle">
            <div class="seg" role="group" aria-label="Room lighting">
              <button type="button" data-lights="on" aria-pressed="false">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
                Lights on
              </button>
              <button type="button" data-lights="off" aria-pressed="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"/></svg>
                Lights off
              </button>
            </div>
          </div>
          <div class="garment" data-garment="{{ garment }}">
            {%- assign patch_id = 'Patch-' | append: section.id -%}
            {% render 'garment-art', garment: garment, patch_id: patch_id %}
          </div>
          <div class="stage-caption">
            <div>
              <div class="name" data-caption-thread>{{ current_thread | escape }}</div>
              <div data-caption-light>Glowing in a dark room</div>
            </div>
            <div>{{ product.title | escape }}</div>
          </div>
        </div>
        <p class="stage-hint">Preview is a guide. Real glow depends on fabric and charge time.</p>

        {%- if product.media.size > 0 -%}
          <div class="product-photos">
            {%- for media in product.media limit: 4 -%}
              {%- if media.media_type == 'image' -%}
                <a href="{{ media | image_url: width: 1600 }}" target="_blank" rel="noopener">
                  {{ media | image_url: width: 300 | image_tag: loading: 'lazy', alt: media.alt | default: product.title }}
                </a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} ---------- Info + steps ---------- {%- endcomment -%}
      <div class="product-info">
        <h1>{{ product.title | escape }}</h1>
        <p class="product-price" data-price>
          {{ current_variant.price | money }}
          {%- if current_variant.compare_at_price > current_variant.price -%}
            <s>{{ current_variant.compare_at_price | money }}</s>
          {%- endif -%}
        </p>
        {%- if product.description != blank -%}
          <div class="product-desc rte">{{ product.description }}</div>
        {%- endif -%}

        <div class="controls">
          {%- if section.settings.show_garment_picker and range.products.size > 1 -%}
            <div class="step">
              <div class="step-head"><span class="step-num">1</span><h2>Choose a garment</h2></div>
              <nav class="garment-picker" aria-label="Garment">
                {%- for p in range.products limit: 10 -%}
                  {%- capture g -%}{% render 'garment-key', product: p %}{%- endcapture -%}
                  {%- assign g = g | strip -%}
                  <a href="{{ p.url }}"{% if p.id == product.id %} aria-current="page"{% endif %}>
                    {% render 'garment-icon', garment: g %}
                    {{ p.title | escape }}
                  </a>
                {%- endfor -%}
              </nav>
            </div>
          {%- endif -%}

          {%- assign step = 1 -%}
          {%- if section.settings.show_garment_picker and range.products.size > 1 -%}{%- assign step = 2 -%}{%- endif -%}

          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              {%- assign option_name = option.name | downcase -%}
              <fieldset class="step" data-option-index="{{ forloop.index0 }}">
                <legend class="step-head">
                  <span class="step-num">{{ step }}</span>
                  <h2>
                    {%- if forloop.index0 == thread_index -%}Pick a thread colour{%- elsif option_name contains 'size' -%}Choose your size{%- else -%}{{ option.name | escape }}{%- endif -%}
                  </h2>
                </legend>
                {%- if forloop.index0 == thread_index -%}
                  <div class="swatches">
                    {%- for value in option.values -%}
                      {%- assign input_id = section.id | append: '-opt' | append: forloop.parentloop.index0 | append: '-' | append: forloop.index0 -%}
                      <div class="swatch">
                        <input type="radio" id="{{ input_id }}" name="{{ section.id }}-option-{{ forloop.parentloop.index0 }}" value="{{ value | escape }}"
                          data-glow="{% render 'thread-colour', name: value, part: 'glow' %}"
                          data-hex="{% render 'thread-colour', name: value, part: 'hex' %}"
                          {% if option.selected_value == value %}checked{% endif %}>
                        <label for="{{ input_id }}"><span class="chip" style="background:{% render 'thread-colour', name: value, part: 'hex' %}"></span>{{ value | escape }}</label>
                      </div>
                    {%- endfor -%}
                  </div>
                {%- elsif option.values.size <= 8 -%}
                  <div class="sizes">
                    {%- for value in option.values -%}
                      {%- assign input_id = section.id | append: '-opt' | append: forloop.parentloop.index0 | append: '-' | append: forloop.index0 -%}
                      <div class="size-pill">
                        <input type="radio" id="{{ input_id }}" name="{{ section.id }}-option-{{ forloop.parentloop.index0 }}" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %}>
                        <label for="{{ input_id }}">{{ value | escape }}</label>
                      </div>
                    {%- endfor -%}
                  </div>
                {%- else -%}
                  <label class="visually-hidden" for="{{ section.id }}-select-{{ forloop.index0 }}">{{ option.name | escape }}</label>
                  <select class="option-select" id="{{ section.id }}-select-{{ forloop.index0 }}" name="{{ section.id }}-option-{{ forloop.index0 }}">
                    {%- for value in option.values -%}
                      <option value="{{ value | escape }}"{% if option.selected_value == value %} selected{% endif %}>{{ value | escape }}</option>
                    {%- endfor -%}
                  </select>
                {%- endif -%}
              </fieldset>
              {%- assign step = step | plus: 1 -%}
            {%- endfor -%}
          {%- endunless -%}

          {%- if section.settings.enable_placement -%}
            <div class="step" data-placement>
              <div class="step-head">
                <span class="step-num">{{ step }}</span><h2>Place your logo</h2>
                <button class="text-btn hint" type="button" data-placement-reset>Reset</button>
              </div>
              <div class="slider-row">
                <label for="{{ section.id }}-x">Left / right</label>
                <input type="range" id="{{ section.id }}-x" min="-40" max="40" step="1" value="0" data-placement-x>
                <span class="val" data-val-x>0</span>
              </div>
              <div class="slider-row">
                <label for="{{ section.id }}-y">Up / down</label>
                <input type="range" id="{{ section.id }}-y" min="-40" max="40" step="1" value="0" data-placement-y>
                <span class="val" data-val-y>0</span>
              </div>
              <div class="slider-row">
                <label for="{{ section.id }}-s">Size</label>
                <input type="range" id="{{ section.id }}-s" min="60" max="180" step="5" value="100" data-placement-s>
                <span class="val" data-val-s>100%</span>
              </div>
            </div>
          {%- endif -%}

          <div class="summary">
            {%- form 'product', product, id: form_id, novalidate: 'novalidate', data-product-form: '' -%}
              <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
              {%- if section.settings.enable_placement -%}
                <input type="hidden" name="properties[Logo position]" value="Centre" data-prop-position>
                <input type="hidden" name="properties[Logo size]" value="100%" data-prop-size>
              {%- endif -%}
              <dl>
                <dt>Garment</dt><dd>{{ product.title | escape }}</dd>
                {%- for option in product.options_with_values -%}
                  {%- unless product.has_only_default_variant -%}
                    <dt>{{ option.name | escape }}</dt><dd data-summary-option="{{ forloop.index0 }}">{{ option.selected_value | escape }}</dd>
                  {%- endunless -%}
                {%- endfor -%}
                {%- if section.settings.enable_placement -%}
                  <dt>Logo</dt><dd data-summary-logo>Centre, 100%</dd>
                {%- endif -%}
              </dl>
              <div class="qty-row">
                <div class="qty">
                  <button type="button" data-qty="-1" aria-label="Decrease quantity">&minus;</button>
                  <input type="number" name="quantity" value="1" min="1" max="20" aria-label="Quantity" data-qty-input>
                  <button type="button" data-qty="1" aria-label="Increase quantity">+</button>
                </div>
                <button class="btn btn-glow" type="submit" data-add-btn {% unless current_variant.available %}disabled{% endunless %}>
                  {%- if current_variant.available -%}Add to cart{%- else -%}Sold out{%- endif -%}
                </button>
              </div>
              <p class="form-status" role="status" aria-live="polite" data-form-status></p>
            {%- endform -%}
            {%- if section.settings.fine_print != blank -%}
              <p class="fine-print">{{ section.settings.fine_print | escape }}</p>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </div>

  <script type="application/json" data-product-json>
    {
      "variants": {{ product.variants | json }},
      "threadIndex": {{ thread_index }},
      "moneyFormat": {{ shop.money_format | json }}
    }
  </script>
</section>

{% schema %}
{
  "name": "Product designer",
  "settings": [
    { "type": "collection", "id": "range_collection", "label": "Garment picker collection", "info": "Products shown in 'Choose a garment'. Leave empty to use all products." },
    { "type": "checkbox", "id": "show_garment_picker", "label": "Show garment picker", "default": true },
    { "type": "checkbox", "id": "enable_placement", "label": "Let customers place the logo", "info": "Position and size are saved on the order line.", "default": true },
    { "type": "text", "id": "fine_print", "label": "Fine print", "default": "Stitched to order. Please allow 5–7 working days before dispatch." }
  ]
}
{% endschema %}
