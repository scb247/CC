{%- capture patch_d -%}{% render 'patch-path' %}{%- endcapture -%}
<section class="hero" id="home">
  <div class="container">
    <div class="hero-grid">
      <div>
        <h1>{{ section.settings.heading | escape }}</h1>
        <p class="hero-lede">{{ section.settings.text | escape }}</p>
        <div class="hero-ctas">
          {%- if section.settings.button_label != blank -%}
            <a class="btn btn-glow" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a>
          {%- endif -%}
          {%- if section.settings.button2_label != blank -%}
            <a class="btn btn-ghost" href="{{ section.settings.button2_link | default: '#how' }}">{{ section.settings.button2_label | escape }}</a>
          {%- endif -%}
        </div>
        {%- if section.settings.show_threads -%}
          <div class="hero-thread-row" data-hero-threads>
            <span>Six thread colours:</span>
            {%- assign threads = 'Green,Blue,Red,White,Pink,Orange' | split: ',' -%}
            {%- for t in threads -%}
              <button type="button" aria-label="Preview {{ t }} glow"
                style="background:{% render 'thread-colour', name: t, part: 'hex' %}"
                data-glow="{% render 'thread-colour', name: t, part: 'glow' %}"></button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
      <div class="hero-visual" aria-hidden="true">
        <div class="hero-halo"></div>
        <svg viewBox="-100 -100 200 200">
          <circle class="ring" r="96" stroke-width="0.6"/>
          <circle class="ring dash" r="84" stroke-width="1"/>
          <circle class="ring" r="70" stroke-width="0.6"/>
          <circle class="ring dash" r="56" stroke-width="1"/>
          <g transform="scale(2.2)"><path class="hero-logo" d="{{ patch_d | strip }}" fill-rule="evenodd"/></g>
        </svg>
      </div>
    </div>
    {%- if section.blocks.size > 0 -%}
      <div class="facts">
        {%- for block in section.blocks -%}
          <div class="fact" {{ block.shopify_attributes }}>
            {%- case block.settings.icon -%}
              {%- when 'sun' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
              {%- when 'moon' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"/></svg>
              {%- else -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20 20 4M14 4h6v6"/><path d="M6 14l4 4"/></svg>
            {%- endcase -%}
            <div><b>{{ block.settings.title | escape }}</b><span>{{ block.settings.text | escape }}</span></div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Glow hero",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Thread that glows when the lights go out." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Glow-in-the-dark embroidery on tees, hoodies, joggers, shorts and long sleeves. Pick your garment, choose your thread colour and preview the glow before it's stitched." },
    { "type": "text", "id": "button_label", "label": "Main button", "default": "Shop the range" },
    { "type": "url", "id": "button_link", "label": "Main button link" },
    { "type": "text", "id": "button2_label", "label": "Second button", "default": "How it works" },
    { "type": "url", "id": "button2_link", "label": "Second button link" },
    { "type": "checkbox", "id": "show_threads", "label": "Show thread colour dots", "default": true }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Fact",
      "limit": 3,
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "sun", "label": "Sun" }, { "value": "moon", "label": "Moon" }, { "value": "needle", "label": "Needle" }
        ], "default": "sun" },
        { "type": "text", "id": "title", "label": "Title", "default": "Charges under any light" },
        { "type": "text", "id": "text", "label": "Text", "default": "Sunlight, lamps or your phone torch." }
      ]
    }
  ],
  "presets": [ { "name": "Glow hero" } ]
}
{% endschema %}
